{
  "defaults": {
    "maxRows": 200,
    "timeoutMs": 15000
  },
  "databases": {
    "local": {
      "engine": "mysql",
      "description": "My localhost dev database",
      "host": "localhost",
      "port": 3306,
      "user": "root",
      "password": "${LOCAL_DB_PASSWORD}",
      "database": "myapp"
    },
    "staging": {
      "engine": "mysql",
      "description": "Staging primary (read-only access)",
      "host": "staging-db.example.com",
      "user": "readonly_user",
      "password": "${STAGING_DB_PASSWORD}",
      "database": "myapp",
      "ssl": true,
      "timeoutMs": 10000
    },
    "hotfix": {
      "engine": "mysql",
      "description": "Hotfix primary (read-only access)",
      "host": "hotfix-db.example.com",
      "user": "readonly_user",
      "password": "${HOTFIX_DB_PASSWORD}",
      "database": "myapp",
      "ssl": true,
      "timeoutMs": 10000
    },
    "production": {
      "engine": "mysql",
      "description": "Production read replica (Aurora reader endpoint)",
      "host": "prod-cluster.cluster-ro-abc123.us-east-1.rds.amazonaws.com",
      "user": "readonly_user",
      "password": "${PROD_DB_PASSWORD}",
      "database": "myapp",
      "ssl": { "caFile": "certs/rds-global-bundle.pem" },
      "requireReplica": true
    }
  }
}

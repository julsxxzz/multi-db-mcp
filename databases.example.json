{
  "defaults": {
    "maxRows": 200,
    "timeoutMs": 15000
  },
  "databases": {
    "local": {
      "engine": "mysql",
      "description": "My localhost dev database",
      "host": "localhost",
      "port": 3306,
      "user": "root",
      "password": "${LOCAL_DB_PASSWORD}",
      "database": "myapp"
    },
    "staging": {
      "engine": "mysql",
      "description": "Staging read replica",
      "host": "staging-db-replica.example.com",
      "user": "readonly_user",
      "password": "${STAGING_DB_PASSWORD}",
      "database": "myapp",
      "ssl": true
    },
    "production": {
      "engine": "mysql",
      "description": "Production read replica (Aurora reader endpoint)",
      "host": "prod-cluster.cluster-ro-abc123.us-east-1.rds.amazonaws.com",
      "user": "readonly_user",
      "password": "${PROD_DB_PASSWORD}",
      "database": "myapp",
      "ssl": { "caFile": "certs/rds-global-bundle.pem" },
      "timeoutMs": 10000
    },
    "prod-via-tunnel": {
      "engine": "postgres",
      "description": "Prod Postgres replica through an SSH tunnel on localhost:15432",
      "host": "127.0.0.1",
      "port": 15432,
      "user": "readonly_user",
      "password": "${PROD_PG_PASSWORD}",
      "database": "myapp",
      "requireReplica": true
    }
  }
}
